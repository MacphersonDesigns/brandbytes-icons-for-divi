{
  "name": "custom-icons-for-divi",
  "version": "0.4.8",
  "private": true,
  "description": "Reusable custom icon libraries and a dedicated Divi 5 Custom Icon module.",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "scripts": {
    "build": "NODE_ENV=production webpack --config webpack.config.js",
    "start": "NODE_ENV=development webpack --watch --config webpack.config.js",
    "test": "npm run test:js",
    "test:js": "jest --runInBand",
    "release:zip": "bash bin/build-release-zip.sh",
    "bump": "bash bin/bump-version.sh"
  },
  "devDependencies": {
    "@divi/types": "npm:divi-types@^1.0.10",
    "@types/jest": "^29.5.14",
    "@types/react": "18.3.1",
    "@types/react-dom": "18.3.0",
    "copy-webpack-plugin": "^14.0.0",
    "css-loader": "^7.1.2",
    "jest": "^29.7.0",
    "mini-css-extract-plugin": "^2.9.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sass": "^1.90.0",
    "sass-loader": "^16.0.5",
    "ts-loader": "^9.5.2",
    "typescript": "^5.9.2",
    "webpack": "^5.101.3",
    "webpack-cli": "^6.0.1"
  }
}
