{
  "name": "cifd/custom-icon",
  "d4Shortcode": "",
  "title": "Custom Icon",
  "titles": "Custom Icons",
  "moduleIcon": "cifd/module-custom-icon",
  "moduleClassName": "cifd_custom_icon",
  "moduleOrderClassName": "cifd_custom_icon",
  "category": "module",
  "childrenName": [],
  "attributes": {
    "module": {
      "type": "object",
      "selector": "{{selector}}",
      "settings": {
        "meta": {
          "meta": {}
        },
        "advanced": {
          "elements": {},
          "html": {}
        },
        "decoration": {
          "animation": {},
          "attributes": {},
          "background": {
            "component": {
              "type": "group",
              "name": "divi/background",
              "props": {
                "hidePanels": ["video"],
                "fields": {
                  "image": {
                    "parallaxEnabled": { "render": false },
                    "parallaxMethod": { "render": false },
                    "size": { "render": false },
                    "width": { "render": false },
                    "height": { "render": false },
                    "position": { "render": false },
                    "horizontalOffset": { "render": false },
                    "verticalOffset": { "render": false },
                    "repeat": { "render": false }
                  }
                }
              }
            }
          },
          "border": {},
          "boxShadow": {},
          "conditions": {},
          "disabledOn": {},
          "filters": {},
          "interactions": {},
          "layout": {},
          "overflow": {},
          "order": {},
          "position": {},
          "scroll": {},
          "sizing": {},
          "spacing": {},
          "sticky": {},
          "transform": {},
          "transition": {},
          "zIndex": {}
        }
      },
      "styleProps": {
        "boxShadow": {
          "useOverlay": true
        },
        "spacing": {
          "important": true
        }
      },
      "styleComponentsProps": {
        "boxShadow": {
          "settings": {
            "overlay": true
          }
        }
      }
    },
    "iconReference": {
      "type": "object",
      "selector": "{{selector}} .et_pb_icon_wrap .cifd-custom-icon__glyph",
      "settings": {
        "innerContent": {
          "groupType": "into-multiple-groups",
          "groups": {
            "icon": {
              "groupType": "group-item",
              "item": {
                "groupSlug": "contentIcon",
                "attrName": "iconReference.innerContent",
                "category": "basic_option",
                "label": "Custom Icon",
                "description": "Choose a reusable icon from this site's icon libraries.",
                "render": true,
                "priority": 10,
                "features": {
                  "preset": "content",
                  "responsive": false,
                  "hover": false,
                  "sticky": false,
                  "dynamicContent": false
                },
                "component": {
                  "type": "field",
                  "name": "cifd/icon-library-picker"
                }
              }
            },
            "link": {
              "groupType": "group-item",
              "item": {
                "priority": 20,
                "groupSlug": "contentLink",
                "attrName": "iconReference.innerContent",
                "render": true,
                "component": {
                  "type": "group",
                  "name": "divi/link",
                  "props": {
                    "groupLabel": "Link",
                    "fieldLabel": "Icon",
                    "grouped": false,
                    "fields": {
                      "url": {
                        "features": { "preset": ["html"] }
                      },
                      "target": {
                        "features": { "preset": ["html"] }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "icon": {
      "type": "object",
      "selector": "{{selector}} .et_pb_icon_wrap .cifd-custom-icon__glyph",
      "supportsCustomAttributes": true,
      "settings": {
        "advanced": {
          "color": {
            "groupType": "group-item",
            "item": {
              "groupSlug": "designIconSize",
              "label": "Icon Color",
              "description": "Choose the color used by monochrome custom icons.",
              "render": true,
              "priority": 10,
              "features": {
                "dynamicContent": {
                  "type": "color"
                }
              },
              "component": {
                "type": "field",
                "name": "divi/color-picker"
              }
            }
          },
          "size": {
            "groupType": "group-item",
            "item": {
              "groupSlug": "designIconSize",
              "category": "layout",
              "label": "Icon Size",
              "description": "Choose the rendered icon size.",
              "render": true,
              "priority": 20,
              "features": {
                "dynamicContent": {
                  "type": "number"
                }
              },
              "component": {
                "type": "field",
                "name": "divi/range",
                "props": {
                  "cssProperty": "font-size",
                  "min": 1,
                  "max": 120
                }
              }
            }
          },
          "align": {
            "groupType": "group-item",
            "item": {
              "groupSlug": "designIconAlignment",
              "category": "layout",
              "label": "Icon Alignment",
              "description": "Align the custom icon within its module.",
              "render": true,
              "priority": 30,
              "features": {
                "hover": false,
                "sticky": false
              },
              "component": {
                "type": "field",
                "name": "divi/button-options",
                "props": {
                  "options": {
                    "left": {
                      "icon": "divi/align-left"
                    },
                    "center": {
                      "icon": "divi/align-center"
                    },
                    "right": {
                      "icon": "divi/align-right"
                    }
                  },
                  "showLabel": false
                }
              }
            }
          }
        }
      }
    },
    "iconLink": {
      "type": "object",
      "selector": "{{selector}}",
      "supportsCustomAttributes": true
    }
  },
  "customCssFields": {
    "iconElement": {
      "subName": "iconElement",
      "label": "Icon Element",
      "selectorSuffix": " .et_pb_icon_wrap .cifd-custom-icon__glyph"
    }
  },
  "settings": {
    "content": "auto",
    "design": "auto",
    "advanced": "auto",
    "groups": {
      "contentIcon": {
        "panel": "content",
        "priority": 10,
        "groupName": "contentIcon",
        "multiElements": true,
        "component": {
          "name": "divi/composite",
          "props": {
            "groupLabel": "Custom Icon"
          }
        }
      },
      "contentLink": {
        "panel": "content",
        "priority": 20,
        "groupName": "link",
        "multiElements": true,
        "component": {
          "name": "divi/composite",
          "props": {
            "groupLabel": "Link"
          }
        }
      },
      "designIconSize": {
        "panel": "design",
        "priority": 10,
        "groupName": "icon",
        "multiElements": true,
        "component": {
          "name": "divi/composite",
          "props": {
            "groupLabel": "Icon",
            "clipboardCategory": "style"
          }
        }
      },
      "designIconAlignment": {
        "panel": "design",
        "priority": 10,
        "groupName": "alignment",
        "multiElements": true,
        "component": {
          "name": "divi/composite",
          "props": {
            "groupLabel": "Alignment",
            "clipboardCategory": "style"
          }
        }
      }
    }
  }
}
